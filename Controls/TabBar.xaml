<UserControl x:Class="PSX.Controls.TabBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PSX.Controls"
             xmlns:models="clr-namespace:PSX.Models"
             xmlns:converters="clr-namespace:PSX.Converters"
             Height="40">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:ProviderIconConverter x:Key="ProviderIconConverter"
                                     DefaultIcon="{StaticResource AgentIconGeometry.Agent}"
                                     ClaudeIcon="{StaticResource AgentIconGeometry.Claude}"
                                     KimiIcon="{StaticResource AgentIconGeometry.Kimi}"
                                     QwenIcon="{StaticResource AgentIconGeometry.Qwen}"
                                     QoderIcon="{StaticResource AgentIconGeometry.Qoder}"
                                     OpencodeIcon="{StaticResource AgentIconGeometry.Opencode}"/>

        <Style x:Key="TabItemContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabSwitchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0,4,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="SwitchSurface"
                                    Margin="1"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="2"
                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Margin="0,0,7,0" Width="12" Height="12">
                                        <!-- Terminal: chevron + prompt line (stroked). -->
                                        <Path x:Name="TerminalIcon"
                                              Data="M1.5,2 L5.5,6 L1.5,10 M6.5,10.5 L11,10.5"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Stretch="Uniform"/>
                                        <!-- Agent: provider brand mark with a generic fallback. -->
                                        <Path x:Name="AgentIcon"
                                              Data="{Binding IconKey, Converter={StaticResource ProviderIconConverter}}"
                                              Fill="{DynamicResource AccentBrush}"
                                              Stretch="Uniform"
                                              Visibility="Collapsed"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Title}"
                                               VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="150"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ActiveIndicator"
                                    Height="2"
                                    Margin="10,0"
                                    VerticalAlignment="Bottom"
                                    CornerRadius="1"
                                    Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:WorkspaceKind.Agent}">
                                <Setter TargetName="TerminalIcon" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="AgentIcon" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="ActiveIndicator" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                            <!-- Visible in another pane but unfocused: muted underline. -->
                            <DataTrigger Binding="{Binding IsPaneVisible}" Value="True">
                                <Setter TargetName="ActiveIndicator" Property="Background" Value="{DynamicResource BorderStrongBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwitchSurface" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabCloseButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseSurface"
                                Margin="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                            <Path Data="M3,3 L9,9 M9,3 L3,9"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="10"
                                  Height="10"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CloseSurface" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NewWorkspaceMenuRowStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RowSurface" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.56"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Tab items -->
        <ScrollViewer Grid.Column="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource TabItemContainerStyle}"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="移到新列"
                                              Visibility="{Binding IsSplit, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                              Command="{Binding PlacementTarget.Tag.MoveTabToNewPaneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding SessionId}"/>
                                    <MenuItem Header="交换两列"
                                              Visibility="{Binding IsSplit, Converter={StaticResource BoolToVisibilityConverter}}"
                                              Command="{Binding PlacementTarget.Tag.SwapPanesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="收回单列"
                                              Visibility="{Binding IsSplit, Converter={StaticResource BoolToVisibilityConverter}}"
                                              Command="{Binding PlacementTarget.Tag.CollapseToSinglePaneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Style="{StaticResource TabSwitchButtonStyle}"
                                        ToolTip="{Binding ToolTip}"
                                        AutomationProperties.Name="{Binding Title}"
                                        Command="{Binding DataContext.SwitchTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding SessionId}"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource TabCloseButtonStyle}"
                                        ToolTip="Close tab"
                                        AutomationProperties.Name="Close tab"
                                        Command="{Binding CloseCommand}"
                                        CommandParameter="{Binding SessionId}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- New workspace: Theme-style anchored popover (not native ContextMenu). -->
        <Grid Grid.Column="1">
            <ToggleButton x:Name="NewWorkspaceButton"
                          ToolTip="New workspace"
                          AutomationProperties.Name="New workspace"
                          Width="40" Height="40"
                          Background="Transparent"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          BorderThickness="0"
                          Cursor="Hand"
                          IsChecked="{Binding IsOpen, ElementName=NewWorkspacePopup, Mode=TwoWay}">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="NewTabSurface"
                                Margin="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                            <Path Data="M10,3 L10,17 M3,10 L17,10"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Width="14"
                                  Height="14"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NewTabSurface" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>

            <Popup x:Name="NewWorkspacePopup"
                   PlacementTarget="{Binding ElementName=NewWorkspaceButton}"
                   Placement="Bottom"
                   HorizontalOffset="-180"
                   VerticalOffset="6"
                   AllowsTransparency="True"
                   PopupAnimation="None"
                   StaysOpen="False">
                <Border Width="220"
                        Padding="8"
                        DataContext="{Binding PlacementTarget.DataContext, ElementName=NewWorkspacePopup}"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding NewWorkspaceToNewPane, Mode=TwoWay}"
                                  Margin="6,2,6,4"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  FontSize="11"
                                  Content="新建到右侧列"/>

                        <Button Style="{StaticResource NewWorkspaceMenuRowStyle}"
                                AutomationProperties.Name="New Terminal"
                                Click="OnNewWorkspaceMenuItemClick"
                                Command="{Binding NewTabCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M1.5,2 L5.5,6 L1.5,10 M6.5,10.5 L11,10.5"
                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Width="12"
                                      Height="12"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="New Terminal"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="NEW AGENT"
                                   Margin="6,10,6,3"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>

                        <ItemsControl ItemsSource="{Binding AgentProviders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource NewWorkspaceMenuRowStyle}"
                                            AutomationProperties.Name="{Binding DisplayName}"
                                            Click="OnNewWorkspaceMenuItemClick"
                                            Command="{Binding DataContext.NewAgentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Key}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{Binding IconKey, Converter={StaticResource ProviderIconConverter}}"
                                                  Fill="{DynamicResource TextSecondaryBrush}"
                                                  Stretch="Uniform"
                                                  Width="12"
                                                  Height="12"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</UserControl>
