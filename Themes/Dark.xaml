<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 设计时 / 默认 fallback — 运行时由 App.xaml.cs 从 psx.ini 动态覆盖 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1d1d1a"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#24231f"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#2b2a25"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#34332d"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#35342e"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3d3b34"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#504d43"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#e8e3d6"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#aaa396"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#7f786d"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#5aa6a0"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6db9b2"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#df7c7c"/>
    <SolidColorBrush x:Key="ErrorBgBrush" Color="#352220"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#d3ae68"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="#312a1c"/>
    <SolidColorBrush x:Key="ScrollbarBrush" Color="#565246"/>
    <SolidColorBrush x:Key="ScrollbarHoverBrush" Color="#6a6658"/>
</ResourceDictionary>
