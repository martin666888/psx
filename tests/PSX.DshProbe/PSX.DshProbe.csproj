<Project Sdk="Microsoft.NET.Sdk">

  <!-- Full-gate WebView2 probe for the DSH overlay. Mock mode (no network)
       answers the production path: second top-level WebView2, one-time
       ?token= exchange, SameSite=Strict cookie, host-mediated export.
       Reports land under TestResults/dsh-probe/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PSX.DshProbe</AssemblyName>
    <RootNamespace>PSX.DshProbe</RootNamespace>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <ProjectReference Include="..\..\PSX.csproj" />
  </ItemGroup>

</Project>
