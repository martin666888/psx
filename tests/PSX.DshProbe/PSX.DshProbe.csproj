<Project Sdk="Microsoft.NET.Sdk">

  <!-- P0 probe for the DSH experiment branch. Part of PSX.slnx so every
       build compiles it; the Full gate runs it in mock mode (no network).
       Artifacts (bin/obj/report) land under TestResults/dsh-probe/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PSX.DshProbe</AssemblyName>
    <RootNamespace>PSX.DshProbe</RootNamespace>
    <BaseIntermediateOutputPath>..\..\TestResults\dsh-probe\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>
