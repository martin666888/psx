{
  "name": "psx-web-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "build:agent": "node test/buildAgent.js",
    "verify:agent": "node test/verifyAgent.js",
    "pretest": "node test/verifyAgent.js",
    "test": "node --test \"test/*.test.js\"",
    "test:watch": "node --test --watch \"test/*.test.js\"",
    "pretest:coverage": "node test/verifyAgent.js",
    "test:coverage": "c8 --all --allowExternal --src=../../wwwroot/js/agent-app --include=**/agent-app/** --reporter=text --reporter=json-summary --reporter=cobertura --reports-dir=../../TestResults/web/coverage node --test \"test/*.test.js\"",
    "typecheck": "tsc --project ../../jsconfig.json"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3"
  }
}
