<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*PSX\.dll$</ModulePath>
      </Include>
      <Exclude>
        <ModulePath>.*PSX\.(Tests|TestAgent|DesktopProbe)\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>
  </CodeCoverage>
</Configuration>
