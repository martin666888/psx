# Lock PSX to Windows x64. Kimi Code's dependency tree can include
# platform-specific optional packages (e.g. node-pty prebuilds). PSX is
# Windows-only, so we refuse to install anything for other platforms. The
# release staging step additionally passes --include=optional to npm so the
# win32-x64 native components are actually installed into tools/kimi.
os=win32
cpu=x64
# Pin the package registry to the official source. The lockfile's `resolved`
# URLs are derived from this — without it, the lockfile can silently end up
# pinning to a mirror that may not have all packages.
registry=https://registry.npmjs.org/
