# Lock PSX to Windows x64. OpenCode ships per-platform binary packages; PSX is
# Windows-only.
os=win32
cpu=x64
# Pin the package registry to the official source. The lockfile's `resolved`
# URLs are derived from this — without it, the lockfile can silently end up
# pinning to a mirror that may not have all packages.
registry=https://registry.npmjs.org/
